# Settings for docker-compose.yml. ./cloudcli-docker creates .env.compose from this file
# the first time (filling in WORKSPACE_PATH, AGENT_UID and AGENT_GID) and never overwrites it.
# This is not the app's own .env. Never commit or share this file once it holds keys.

# --- Where your projects are ---------------------------------------------------
# Host folder mounted at /workspace (the projects you open in the UI). It must be owned
# by AGENT_UID:AGENT_GID below.
WORKSPACE_PATH=./workspace
# The user the agents run as inside the container. These must be the owner of
# WORKSPACE_PATH: the container changes its user to them at start. Not 0 (root).
AGENT_UID=1000
AGENT_GID=1000

# --- Access ----------------------------------------------------------------------
# Port the UI is published on, on this machine.
CLOUDCLI_PORT=3001
# Optional API keys. Both can also be set from the UI.
KIRO_API_KEY=
ANTHROPIC_API_KEY=
# Maven settings.xml mounted read-only at ~/.m2/settings.xml (repository credentials, mirrors).
# Absolute path to a file. Unset: an empty one is mounted.
# MAVEN_SETTINGS_PATH=/home/you/secrets/maven-settings.xml

# --- Images ----------------------------------------------------------------------
# Version of the app image. Set when this release was made; change it to run another one
# (for example `latest`).
# CLOUDCLI_VERSION=
# Version of the ssh-agent image. It has its own numbers and changes rarely.
# CLOUDCLI_SSH_AGENT_VERSION=
# Registry the images come from. Point it at your own mirror if the machine cannot
# reach ghcr.io; the images are <registry>/cloudcli and <registry>/cloudcli-ssh-agent.
# A proxy is not set here: see docker-compose.proxy.example.yml.
# CLOUDCLI_REGISTRY=ghcr.io/nmng108

# --- Docker for the agents (optional; ./cloudcli-docker up --dind) -------------------
# See docs/docker-in-docker.md in the CloudCLI repository.
# Host ports, on localhost only, for containers the agents start with -p.
DIND_PORTS=7080-7089
# Limits of the daemon container. Raise for heavy builds.
# DIND_MEMORY=6g
# DIND_PIDS=4096
# Daemon images. Keep their major version equal to the Docker CLI in the app image.
# DIND_IMAGE=docker:29-dind-rootless
# DIND_PRIVILEGED_IMAGE=docker:29-dind
