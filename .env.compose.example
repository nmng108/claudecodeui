# Variables for the Docker Compose files (docker-compose.yml and
# docker-compose.dev.yml). This is NOT the app's .env: the app reads a `.env`
# at the repository root, which the dev container also sees through its bind
# mount, so these values are kept in a separate file.
#
# Copy to .env.compose (git-ignored) and pass it to compose:
#   cp .env.compose.example .env.compose
#   docker compose --env-file .env.compose -f docker-compose.dev.yml up --build
# or export COMPOSE_ENV_FILES=.env.compose once instead of repeating the flag.
#
# Never commit real keys.

# --- Both stacks -------------------------------------------------------------
# Host folder mounted at /workspace (the projects you open in the UI).
WORKSPACE_PATH=./
KIRO_API_KEY=
ANTHROPIC_API_KEY=

# --- docker-compose.yml (published package) ----------------------------------
# npm dist-tag or version of @namng108/cloudcli to install, and the registry.
CLOUDCLI_VERSION=latest
NPM_REGISTRY=https://registry.npmjs.org

# --- docker-compose.dev.yml (source tree with hot reload) --------------------
# Host ports for the Vite UI and the API server.
DEV_UI_PORT=5173
DEV_SERVER_PORT=3001
# uid/gid of the container user. Set to your host user's (`id -u`, `id -g`) so
# the container can write to the bind-mounted repository. Changing them needs
# a rebuild and fresh dev-* volumes (`docker compose ... down -v`).
AGENT_UID=1000
AGENT_GID=1000
# Set to true when host edits do not trigger a reload (bind mounts from
# Windows/macOS do not always deliver file-change events).
VITE_USE_POLLING=false

# Kiro CLI engine used by CloudCLI: v3 (default) or v2.
CLOUDCLI_KIRO_ENGINE=v3
